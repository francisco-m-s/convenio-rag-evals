# Plantilla de variables de entorno. Copia este fichero a `.env` y rellénalo; el `.env` nunca se sube.
# Aquí todos los valores van VACÍOS: el escáner de secretos bloquea cualquier valor real.

# Proveedor de modelos para la generación: cualquier endpoint compatible con la API de chat de OpenAI.
# Con una pasarela LiteLLM se obtiene además el coste de cada petición (cabecera x-litellm-response-cost).
# Si falta alguno de los tres primeros, la API arranca igualmente pero /preguntar responde 503 (/buscar sigue).
# LLM_BASE_URL: la URL de la pasarela terminada en /v1. LLM_RAZONAMIENTO: valor de reasoning_effort, opcional.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODELO=
LLM_RAZONAMIENTO=

# API propia: token de los endpoints de administración (/ingestar, /trazas, /informe) y secreto del webhook de entrada.
# Sin ellos esos endpoints quedan deshabilitados (403). Si se definen, deben tener al menos 16 caracteres.
TOKEN_INGESTA=
SECRETO_WEBHOOK=

# Opcionales (se indica entre paréntesis el valor por defecto cuando se dejan vacíos).
# RAG_DB: base de búsqueda (datos/convenio.db). RAG_TROZOS: texto troceado que se indexa (datos/trozos.jsonl).
# RAG_TRAZAS: trazas por petición (datos/trazas.db). RAG_LIMITE_MIN: peticiones por minuto y cliente (30).
# RAG_EMBEDDINGS: modelo de fastembed (jinaai/jina-embeddings-v2-base-es; se descarga la primera vez, 0,64 GB).
# RAG_LIMITE_CHAT_MIN: mensajes por minuto y chat en el webhook (5).
# RAG_TOPE_DIARIO_PETICIONES: peticiones al modelo por día UTC, en /preguntar y el webhook (1000).
# RAG_TOPE_DIARIO_USD: gasto máximo por día UTC; sin valor no hay tope de gasto (solo funciona si el proveedor da el coste).
RAG_DB=
RAG_TROZOS=
RAG_TRAZAS=
RAG_EMBEDDINGS=
RAG_LIMITE_MIN=
RAG_LIMITE_CHAT_MIN=
RAG_TOPE_DIARIO_PETICIONES=
RAG_TOPE_DIARIO_USD=

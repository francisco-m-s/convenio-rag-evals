# Plantilla de variables de entorno. Copia este fichero a `.env` y rellénalo; el `.env` nunca se sube.
# Aquí todos los valores van VACÍOS: el escáner de secretos bloquea cualquier valor real.

# Claves de los proveedores de modelos (rellena solo el que vayas a usar).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=

# API propia (fases 1 y 4): token del endpoint de escritura y secreto del webhook de entrada.
TOKEN_INGESTA=
SECRETO_WEBHOOK=
